    "lilys_tiktok_reviews": {
      "type": "lilys-tiktok-reviews",
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "quote": "I bought these for my kids and now I'M the one eating them in the car. The chili is just enough \u2014 sweet, sour, spicy. Absolute 10/10.",
            "name": "Maya R.",
            "initials": "MR",
            "handle": "@mayareviews"
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "quote": "The chili strawberry belts are UNREAL. I sent a box to my sister and now she orders them every month. Best gummy candy ever made.",
            "name": "Dani T.",
            "initials": "DT",
            "handle": "@dani.tastes"
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "quote": "Hosted a party and the candy platter disappeared in 20 minutes. Every flavor was a hit \u2014 the chili peach is dangerous.",
            "name": "Sam K.",
            "initials": "SK",
            "handle": "@sam.snacks"
          }
        },
        "r4": {
          "type": "review",
          "settings": {
            "quote": "I usually don't like super sour stuff but the chamoy hit is perfect. You can taste the real chili. Worth every penny.",
            "name": "Alex P.",
            "initials": "AP",
            "handle": "@alex.p"
          }
        },
        "r5": {
          "type": "review",
          "settings": {
            "quote": "Found this brand on TikTok and I'm hooked. Shipping was fast, packaging was cute, candy is elite. Converted for life.",
            "name": "Jasmine L.",
            "initials": "JL",
            "handle": "@jasmine.l"
          }
        },
        "r6": {
          "type": "review",
          "settings": {
            "quote": "The watermelon gummies are the perfect balance of sweet and spicy. Brought them to my dorm and now everyone is ordering.",
            "name": "Marcus B.",
            "initials": "MB",
            "handle": "@marcusb"
          }
        }
      },
