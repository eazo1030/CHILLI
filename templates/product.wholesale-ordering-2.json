{"sections":{"1778652418ed93a8b3":{"type":"_blocks","blocks":{"ai_gen_block_3c014de_xwy4Gq":{"type":"ai_gen_block_3c014de","settings":{"title":"Wholesale Ordering","text_alignment":"center","title_size":32,"title_weight":"700","text_transform":"none","letter_spacing":0,"background_color":"#ef6a6a","background_gradient":"","text_color":"#ffffff","stripe_color":"#ffffff","stripe_opacity":20,"desktop_width_percent":100,"padding_vertical":20,"padding_horizontal":40,"border_radius":0},"blocks":{}}},"block_order":["ai_gen_block_3c014de_xwy4Gq"],"settings":{}},"main":{"type":"main-product","blocks":{"custom_liquid_qC7AAN":{"type":"custom_liquid","settings":{"custom_liquid":"<div class=\"wholesale-custom-form\">\n\n  <div class=\"wholesale-options\">\n    {% for variant in product.variants %}\n      <div class=\"wholesale-option\">\n\n        <label class=\"wholesale-label\">\n          <input\n            type=\"checkbox\"\n            class=\"variant-checkbox\"\n            value=\"{{ variant.id }}\"\n          >\n\n          {% if variant.image %}\n            <img\n              src=\"{{ variant.image | image_url: width: 80 }}\"\n              alt=\"{{ variant.title }}\"\n              class=\"variant-thumb\"\n              loading=\"lazy\"\n            >\n          {% endif %}\n\n          <span class=\"flavor-name\">\n            {{ variant.title }}\n          <\/span>\n        <\/label>\n\n        <div class=\"qty-stepper\">\n          <button type=\"button\" class=\"qty-btn minus\">−<\/button>\n\n          <input\n            type=\"number\"\n            class=\"variant-qty\"\n            value=\"1\"\n            min=\"1\"\n            step=\"1\"\n            disabled\n          >\n\n          <button type=\"button\" class=\"qty-btn plus\">+<\/button>\n        <\/div>\n\n        <span class=\"bag-count\">24 bags<\/span>\n\n      <\/div>\n    {% endfor %}\n  <\/div>\n\n  <div class=\"wholesale-total-box\">\n\n    <div class=\"total-stat\">\n      <div class=\"total-label\">Total Cases<\/div>\n      <div class=\"total-number\" id=\"total-cases\">0<\/div>\n    <\/div>\n\n    <div class=\"total-stat\">\n      <div class=\"total-label\">Total Bags<\/div>\n      <div class=\"total-number\" id=\"total-bags\">0<\/div>\n    <\/div>\n\n    <div class=\"total-stat pallet-stat\">\n      <div class=\"total-label\">\n        Cases Until Full Pallet<br>\n        <span class=\"free-ship-text\">+ FREE SHIPPING<\/span>\n      <\/div>\n      <div class=\"total-number\" id=\"cases-remaining\">80<\/div>\n    <\/div>\n\n  <\/div>\n\n  <button\n    type=\"button\"\n    class=\"button wholesale-add-btn\"\n    onclick=\"addSelectedVariants()\"\n  >\n    Add Selected Cases to Cart\n  <\/button>\n\n<\/div>\n\n<style>\n  .wholesale-custom-form {\n    margin-top: 20px;\n  }\n\n  .wholesale-options {\n    display: grid;\n    gap: 8px;\n  }\n\n  .wholesale-option {\n    display: grid;\n    grid-template-columns: 1fr auto auto;\n    align-items: center;\n    gap: 10px;\n    padding: 10px 12px;\n    border: 1px solid #e5e5e5;\n    border-radius: 8px;\n    background: #fff;\n  }\n\n  .wholesale-label {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-weight: 600;\n    cursor: pointer;\n    margin: 0;\n    min-width: 0;\n  }\n\n  .wholesale-label input[type=\"checkbox\"] {\n    width: 18px;\n    height: 18px;\n    cursor: pointer;\n    flex-shrink: 0;\n  }\n\n  .variant-thumb {\n    width: 42px;\n    height: 42px;\n    object-fit: cover;\n    border-radius: 6px;\n    border: 1px solid #e5e5e5;\n    flex-shrink: 0;\n  }\n\n  .flavor-name {\n    font-size: 14px;\n    line-height: 1.2;\n  }\n\n  .qty-stepper {\n    display: flex;\n    align-items: center;\n    border: 1px solid #ddd;\n    border-radius: 6px;\n    overflow: hidden;\n    width: fit-content;\n  }\n\n  .qty-btn {\n    width: 32px;\n    height: 32px;\n    border: none;\n    background: #f5f5f5;\n    font-size: 20px;\n    cursor: pointer;\n    line-height: 1;\n    padding: 0;\n  }\n\n  .variant-qty {\n    width: 46px;\n    height: 32px;\n    border: none;\n    text-align: center;\n    font-size: 14px;\n    padding: 0;\n  }\n\n  .variant-qty::-webkit-outer-spin-button,\n  .variant-qty::-webkit-inner-spin-button {\n    -webkit-appearance: none;\n    margin: 0;\n  }\n\n  .variant-qty[type=number] {\n    -moz-appearance: textfield;\n  }\n\n  .variant-qty:disabled {\n    opacity: 0.45;\n  }\n\n  .bag-count {\n    font-size: 13px;\n    white-space: nowrap;\n    color: #555;\n  }\n\n  .wholesale-total-box {\n    margin-top: 16px;\n    padding: 14px;\n    border-radius: 12px;\n    background: linear-gradient(135deg, #ff5757, #ff914d);\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 10px;\n    color: white;\n  }\n\n  .total-stat {\n    background: rgba(255,255,255,0.12);\n    border-radius: 10px;\n    padding: 12px 10px;\n    text-align: center;\n  }\n\n  .total-label {\n    font-size: 12px;\n    opacity: 0.95;\n    margin-bottom: 4px;\n    line-height: 1.3;\n  }\n\n  .free-ship-text {\n    display: inline-block;\n    margin-top: 2px;\n    font-size: 10px;\n    font-weight: 700;\n    color: #fff8b3;\n    letter-spacing: 0.3px;\n  }\n\n  .total-number {\n    font-size: 24px;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  .pallet-stat .total-number {\n    color: #fff8b3;\n  }\n\n  .wholesale-add-btn {\n    margin-top: 14px;\n    width: 100%;\n  }\n\n  @media screen and (max-width: 768px) {\n\n    .wholesale-options {\n      gap: 6px;\n    }\n\n    .wholesale-option {\n      grid-template-columns: 1fr auto;\n      gap: 6px 8px;\n      padding: 8px 10px;\n      align-items: center;\n    }\n\n    .wholesale-label {\n      gap: 6px;\n    }\n\n    .wholesale-label input[type=\"checkbox\"] {\n      width: 16px;\n      height: 16px;\n    }\n\n    .variant-thumb {\n      width: 36px;\n      height: 36px;\n    }\n\n    .flavor-name {\n      font-size: 13px;\n    }\n\n    .qty-stepper {\n      margin-left: 0;\n      transform: scale(0.92);\n      transform-origin: right center;\n    }\n\n    .bag-count {\n      grid-column: 2;\n      margin-left: 0;\n      text-align: right;\n      font-size: 11px;\n      line-height: 1;\n    }\n\n    .wholesale-total-box {\n      grid-template-columns: 1fr;\n      gap: 8px;\n    }\n\n    .total-stat {\n      padding: 10px;\n    }\n\n    .total-number {\n      font-size: 20px;\n    }\n\n    .total-label {\n      font-size: 11px;\n    }\n\n    .wholesale-add-btn {\n      padding: 14px;\n      font-size: 15px;\n    }\n\n  }\n<\/style>\n\n<script>\n  function updateWholesaleTotals() {\n    let totalCases = 0;\n    let totalBags = 0;\n\n    document.querySelectorAll('.wholesale-option').forEach(function(row) {\n      const checkbox = row.querySelector('.variant-checkbox');\n      const qtyInput = row.querySelector('.variant-qty');\n      const bagCount = row.querySelector('.bag-count');\n\n      let qty = parseInt(qtyInput.value) || 0;\n      let bags = qty * 24;\n\n      if (qty < 1) {\n        bags = 0;\n      }\n\n      bagCount.textContent = bags + ' bags';\n\n      if (checkbox.checked) {\n        totalCases += qty;\n        totalBags += bags;\n      }\n    });\n\n    document.getElementById('total-cases').textContent = totalCases;\n    document.getElementById('total-bags').textContent = totalBags;\n\n    let remaining = 80 - totalCases;\n\n    if (remaining < 0) {\n      remaining = 0;\n    }\n\n    document.getElementById('cases-remaining').textContent = remaining;\n  }\n\n  document.querySelectorAll('.variant-checkbox').forEach(function(checkbox) {\n    checkbox.addEventListener('change', function() {\n      const row = this.closest('.wholesale-option');\n      const qtyInput = row.querySelector('.variant-qty');\n\n      qtyInput.disabled = !this.checked;\n\n      if (this.checked && (qtyInput.value === '' || parseInt(qtyInput.value) < 1)) {\n        qtyInput.value = 1;\n      }\n\n      updateWholesaleTotals();\n    });\n  });\n\n  document.querySelectorAll('.variant-qty').forEach(function(input) {\n    input.addEventListener('focus', function() {\n      if (this.value == 1) {\n        this.value = '';\n      }\n    });\n\n    input.addEventListener('blur', function() {\n      if (this.value === '' || parseInt(this.value) < 1) {\n        this.value = 1;\n      }\n\n      updateWholesaleTotals();\n    });\n\n    input.addEventListener('input', function() {\n      updateWholesaleTotals();\n    });\n  });\n\n  document.querySelectorAll('.qty-btn.plus').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n      const row = this.closest('.wholesale-option');\n      const input = row.querySelector('.variant-qty');\n\n      if (input.disabled) return;\n\n      input.value = parseInt(input.value || 0) + 1;\n\n      updateWholesaleTotals();\n    });\n  });\n\n  document.querySelectorAll('.qty-btn.minus').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n      const row = this.closest('.wholesale-option');\n      const input = row.querySelector('.variant-qty');\n\n      if (input.disabled) return;\n\n      let current = parseInt(input.value || 1);\n\n      if (current > 1) {\n        input.value = current - 1;\n      }\n\n      updateWholesaleTotals();\n    });\n  });\n\n  function addSelectedVariants() {\n    const selectedItems = [];\n\n    document.querySelectorAll('.variant-checkbox:checked').forEach(function(checkbox) {\n      const row = checkbox.closest('.wholesale-option');\n      const qty = parseInt(row.querySelector('.variant-qty').value) || 1;\n\n      selectedItems.push({\n        id: parseInt(checkbox.value),\n        quantity: qty\n      });\n    });\n\n    if (selectedItems.length === 0) {\n      alert('Please select at least one flavor.');\n      return;\n    }\n\n    fetch('\/cart\/add.js', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application\/json'\n      },\n      body: JSON.stringify({\n        items: selectedItems\n      })\n    })\n    .then(function(response) {\n      return response.json();\n    })\n    .then(function(data) {\n      window.location.href = '\/cart';\n    })\n    .catch(function(error) {\n      console.error(error);\n      alert('Something went wrong. Please try again.');\n    });\n  }\n\n  updateWholesaleTotals();\n<\/script>"}},"price":{"type":"price","disabled":true,"settings":{}},"variant_picker":{"type":"variant_picker","disabled":true,"settings":{"picker_type":"dropdown","swatch_shape":"circle"}},"quantity_selector":{"type":"quantity_selector","disabled":true,"settings":{}},"buy_buttons":{"type":"buy_buttons","disabled":true,"settings":{"show_dynamic_checkout":false,"show_gift_card_recipient":false}},"description":{"type":"description","settings":{}},"share":{"type":"share","settings":{"share_label":"Share"}},"stamped_product_reviews_ugc_main_widget_ab7j8h":{"type":"shopify:\/\/apps\/stamped-reviews\/blocks\/main-widget\/a103faaf-2125-4b0e-89fa-de5149736723","settings":{"animation":true,"tags_exclude":"","tags_include":"","search":"","linkify":true,"use_metafields":false,"sku_tagtype":"sku"}}},"block_order":["custom_liquid_qC7AAN","price","variant_picker","quantity_selector","buy_buttons","description","share","stamped_product_reviews_ugc_main_widget_ab7j8h"],"settings":{"enable_sticky_info":true,"color_scheme":"scheme-1","media_size":"small","constrain_to_viewport":true,"media_fit":"cover","gallery_layout":"stacked","media_position":"left","image_zoom":"lightbox","mobile_thumbnails":"show","hide_variants":false,"enable_video_looping":true,"padding_top":36,"padding_bottom":12}},"related-products":{"type":"related-products","settings":{"heading":"You may also like","heading_size":"h2","products_to_show":4,"columns_desktop":4,"color_scheme":"scheme-1","image_ratio":"square","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"columns_mobile":"2","padding_top":36,"padding_bottom":28}},"17074481709082ec8c":{"type":"apps","settings":{"