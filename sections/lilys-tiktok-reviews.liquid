<div class="lilys-tiktok-reviews" id="lilys-tiktok-reviews">
  <div class="page-width">
    <div class="lilys-tiktok-reviews__header lilys-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lilys-tiktok-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lilys-tiktok-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="lilys-tiktok-reviews__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="lilys-tiktok-reviews__grid lilys-reveal-stagger" id="lilys-tiktok-grid">
      {%- for block in section.blocks -%}
        <article class="lilys-tiktok-card" {{ block.shopify_attributes }}>
          <span class="lilys-tiktok-card__heart" aria-hidden="true">♥</span>
          <p class="lilys-tiktok-card__quote">{{ block.settings.quote }}</p>
          <div class="lilys-tiktok-card__meta">
            <span class="lilys-tiktok-card__avatar" aria-hidden="true">{{ block.settings.initials | slice: 0, 2 | upcase }}</span>
            <div>
              <p class="lilys-tiktok-card__name">{{ block.settings.name | escape }}</p>
              <p class="lilys-tiktok-card__handle">
                <svg class="lilys-tiktok-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.84a8.16 8.16 0 0 0 4.77 1.52V6.91a4.85 4.85 0 0 1-1.84-.22z"/>
                </svg>
                {{ block.settings.handle | escape }}
              </p>
            </div>
          </div>
          <div class="lilys-tiktok-card__stars" aria-label="5 out of 5 stars">★ ★ ★ ★ ★</div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="lilys-tiktok-reviews__cta" style="text-align:center; margin-top:4rem; position:relative; z-index:1;">
        <a
          class="button"
          href="{{ section.settings.cta_link | default: '#' }}"
        >
          {{ section.settings.cta_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TikTok reviews",
  "tag": "section",
  "class": "section section--lilys-tiktok-reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "As seen on TikTok"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What customers are <em>saying</em>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews from the Lily's Chilies community"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop the favorites"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Add a verified customer quote here." },
        { "type": "text", "id": "name", "label": "Name", "default": "Maya R." },
        { "type": "text", "id": "initials", "label": "Initials", "default": "MR" },
        { "type": "text", "id": "handle", "label": "TikTok handle", "default": "@mayareviews" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "TikTok reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "I bought these for my kids and now I'M the one eating them in the car. The chili is just enough — sweet, sour, spicy. Absolute 10/10.", "name": "Maya R.", "initials": "MR", "handle": "@mayareviews" } },
        { "type": "review", "settings": { "quote": "The chili strawberry belts are UNREAL. I sent a box to my sister and now she orders them every month. Best gummy candy ever made.", "name": "Dani T.", "initials": "DT", "handle": "@dani.tastes" } },
        { "type": "review", "settings": { "quote": "Hosted a party and the candy platter disappeared in 20 minutes. Every flavor was a hit — the chili peach is dangerous.", "name": "Sam K.", "initials": "SK", "handle": "@sam.snacks" } },
        { "type": "review", "settings": { "quote": "I usually don't like super sour stuff but the chamoy hit is perfect. You can taste the real chili. Worth every penny.", "name": "Alex P.", "initials": "AP", "handle": "@alex.p" } },
        { "type": "review", "settings": { "quote": "Found this brand on TikTok and I'm hooked. Shipping was fast, packaging was cute, candy is elite. Converted for life.", "name": "Jasmine L.", "initials": "JL", "handle": "@jasmine.l" } },
        { "type": "review", "settings": { "quote": "The watermelon gummies are the perfect balance of sweet and spicy. Brought them to my dorm and now everyone is ordering.", "name": "Marcus B.", "initials": "MB", "handle": "@marcusb" } }
      ]
    }
  ]
}
{% endschema %}
