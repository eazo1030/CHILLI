{%- if section.settings.heading != blank or section.settings.subheading != blank -%}
  <div class="lilys-marquee">
    <div class="lilys-marquee__track">
      {%- for i in (1..3) -%}
        <span>{{ section.settings.heading | escape }} <span class="lilys-marquee__dot" aria-hidden="true"></span></span>
        <span>{{ section.settings.subheading | escape }} <span class="lilys-marquee__dot" aria-hidden="true"></span></span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "USP marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FREE SHIPPING OVER $50" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "SAME-DAY SHIPPING" }
  ],
  "presets": [
    { "name": "USP marquee" }
  ]
}
{% endschema %}
