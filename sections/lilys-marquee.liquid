{%- if section.settings.text_1 != blank or section.settings.text_2 != blank or section.settings.text_3 != blank or section.settings.text_4 != blank -%}
  <aside class="lc-promise-bar" aria-label="Store promises">
    <div class="lc-gummy-runway" aria-hidden="true">
      <div class="lc-gummy-runner">
        <div class="lc-gummy-runner__bounce">
          <div class="lc-gummy-runner__rig">
            <span class="lc-gummy-runner__leg lc-gummy-runner__leg--back"></span>
            <span class="lc-gummy-runner__leg lc-gummy-runner__leg--front"></span>
            <img
              class="lc-gummy-runner__sprite"
              src="{{ 'lilys-logo-bear-chili-clean.png' | asset_url }}"
              alt=""
              width="264"
              height="432"
              loading="eager"
              decoding="async"
              aria-hidden="true"
            >
          </div>
        </div>
      </div>
    </div>
    <div class="page-width">
      <ul class="lc-promise-bar__list" role="list">
        {%- for i in (1..4) -%}
          {%- liquid
            assign text_key = 'text_' | append: i
            assign item_text = section.settings[text_key]
          -%}
          {%- if item_text != blank -%}
            <li>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="m4 10 3.5 3.5L16 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ item_text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Brand promise bar",
  "tag": "section",
  "class": "section section--lilys-marquee",
  "settings": [
    { "type": "text", "id": "text_1", "label": "Promise 1", "default": "SHIPS NATIONWIDE" },
    { "type": "text", "id": "text_2", "label": "Promise 2", "default": "BOLD CHAMOY FLAVOR" },
    { "type": "text", "id": "text_3", "label": "Promise 3", "default": "SECURE CHECKOUT" },
    { "type": "text", "id": "text_4", "label": "Promise 4", "default": "MADE FOR SHARING" }
  ],
  "presets": [
    { "name": "Brand promise bar" }
  ]
}
{% endschema %}
