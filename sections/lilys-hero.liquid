{%- comment -%} v2026-08-08 graphic slideshow rebuild {%- endcomment -%}
{%- liquid
  assign slide_1_product = all_products['chili-strawberry-belts-two-pack-4oz']
  assign slide_1_sour = all_products['copy-of-chili-apple-sour-belts']
  assign slide_1_watermelon = all_products['chili-watermelon-gummies-two-pack-4oz']

  assign slide_2_blueberry = all_products['chili-blueberry-belts-two-pack-4oz']
  assign slide_2_mango = all_products['chili-dried-mango']
  assign slide_2_apple = all_products['chili-apple-belts-two-pack-4oz']
  assign slide_2_strawberry = all_products['chili-strawberry-belts-two-pack-4oz']

  assign slide_3_mango = all_products['chili-dried-mango']
  assign slide_3_plum = all_products['chili-lavashak-fruit-roll']
  assign slide_3_peach = all_products['chili-peach-gummies-two-pack-4oz']
-%}

<section class="lc-hero lc-hero--graphic lc-hero-2026-08-08" aria-labelledby="LcHeroHeading-{{ section.id }}">
  <h1 class="visually-hidden" id="LcHeroHeading-{{ section.id }}">{{ section.settings.heading | default: 'Lily\'s Chilies — Sweet. Sour. Spicy.' | strip_html }}</h1>

  <div
    class="lc-hero-slider lc-hero-slider--graphic"
    data-lc-hero-slider
    role="region"
    aria-roledescription="carousel"
    aria-label="Lily's Chilies flavor highlights"
  >
    <div class="lc-hero__media lc-hero__media--graphic" id="LcHeroSlides-{{ section.id }}">

      <div
        class="lc-hero-slide lc-hero-slide--graphic is-active"
        data-lc-hero-slide
        data-lc-slide-index="0"
        aria-hidden="false"
      >
        <img
          class="lc-hero__image lc-hero__image--graphic"
          src="{{ 'lilys-hero-slide-sweet-sour-spicy.jpg' | asset_url }}"
          alt="Sweet. Sour. Spicy. Chamoy-coated gummy candy with a kick."
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
        >
        <div class="lc-hero__hotspots" aria-hidden="{% if slide_1_product == blank and slide_1_sour == blank and slide_1_watermelon == blank %} true {% else %} false {% endif %}">
          {%- if slide_1_product != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_1_product.url }}" style="left:53.1%;top:13.9%;width:25.8%;height:42.4%;">
              <span class="visually-hidden">Shop {{ slide_1_product.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if slide_1_sour != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_1_sour.url }}" style="left:46.5%;top:58.3%;width:16.0%;height:29.9%;">
              <span class="visually-hidden">Shop {{ slide_1_sour.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if slide_1_watermelon != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_1_watermelon.url }}" style="left:71.5%;top:55.6%;width:14.5%;height:32.6%;">
              <span class="visually-hidden">Shop {{ slide_1_watermelon.title | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div
        class="lc-hero-slide lc-hero-slide--graphic"
        data-lc-hero-slide
        data-lc-slide-index="1"
        aria-hidden="true"
        tabindex="-1"
      >
        <img
          class="lc-hero__image lc-hero__image--graphic"
          src="{{ 'lilys-hero-slide-whats-your-flavor.jpg' | asset_url }}"
          alt="What's your flavor? Pick a bag. Take a bite. Feel the sweet heat."
          width="1280"
          height="720"
          loading="lazy"
        >
        <div class="lc-hero__hotspots" aria-hidden="{% if slide_2_blueberry == blank and slide_2_mango == blank and slide_2_apple == blank and slide_2_strawberry == blank %} true {% else %} false {% endif %}">
          {%- if slide_2_blueberry != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_2_blueberry.url }}" style="left:4.7%;top:29.2%;width:21.1%;height:36.1%;">
              <span class="visually-hidden">Shop {{ slide_2_blueberry.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if slide_2_mango != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_2_mango.url }}" style="left:28.5%;top:29.2%;width:20.3%;height:36.1%;">
              <span class="visually-hidden">Shop {{ slide_2_mango.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if slide_2_apple != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_2_apple.url }}" style="left:52.0%;top:29.2%;width:19.5%;height:36.1%;">
              <span class="visually-hidden">Shop {{ slide_2_apple.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if slide_2_strawberry != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_2_strawberry.url }}" style="left:75.4%;top:29.2%;width:20.3%;height:36.1%;">
              <span class="visually-hidden">Shop {{ slide_2_strawberry.title | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div
        class="lc-hero-slide lc-hero-slide--graphic"
        data-lc-hero-slide
        data-lc-slide-index="2"
        aria-hidden="true"
        tabindex="-1"
      >
        <img
          class="lc-hero__image lc-hero__image--graphic"
          src="{{ 'lilys-hero-slide-sweet-heat-balance.jpg' | asset_url }}"
          alt="The perfect sweet-heat balance. Soft, chewy candy tossed in a mouthwatering chili blend."
          width="1280"
          height="720"
          loading="lazy"
        >
        <div class="lc-hero__hotspots" aria-hidden="{% if slide_3_mango == blank and slide_3_plum == blank and slide_3_peach == blank %} true {% else %} false {% endif %}">
          {%- if slide_3_mango != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_3_mango.url }}" style="left:5.5%;top:13.2%;width:20.3%;height:41.7%;">
              <span class="visually-hidden">Shop {{ slide_3_mango.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if slide_3_plum != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_3_plum.url }}" style="left:31.3%;top:6.9%;width:17.2%;height:33.3%;">
              <span class="visually-hidden">Shop {{ slide_3_plum.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if slide_3_peach != blank -%}
            <a class="lc-hero__hotspot" href="{{ slide_3_peach.url }}" style="left:21.1%;top:41.7%;width:22.7%;height:38.9%;">
              <span class="visually-hidden">Shop {{ slide_3_peach.title | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>

    </div>

    <button
      type="button"
      class="lc-hero-slider__button lc-hero-slider__button--previous"
      data-lc-slide-previous
      aria-label="Previous flavor highlight"
      aria-controls="LcHeroSlides-{{ section.id }}"
    ><span aria-hidden="true">‹</span></button>
    <button
      type="button"
      class="lc-hero-slider__button lc-hero-slider__button--next"
      data-lc-slide-next
      aria-label="Next flavor highlight"
      aria-controls="LcHeroSlides-{{ section.id }}"
    ><span aria-hidden="true">›</span></button>
    <div class="lc-hero-slider__dots" role="group" aria-label="Choose flavor highlight">
      <button type="button" class="lc-hero-slider__dot is-active" data-lc-slide-dot="0" aria-label="Show slide 1" aria-controls="LcHeroSlides-{{ section.id }}" aria-current="true"></button>
      <button type="button" class="lc-hero-slider__dot" data-lc-slide-dot="1" aria-label="Show slide 2" aria-controls="LcHeroSlides-{{ section.id }}"></button>
      <button type="button" class="lc-hero-slider__dot" data-lc-slide-dot="2" aria-label="Show slide 3" aria-controls="LcHeroSlides-{{ section.id }}"></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lily graphic hero v2",
  "tag": "section",
  "class": "section section--lilys-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Hidden accessible heading (SEO only, not visible — the slides carry their own text)",
      "default": "Lily's Chilies — Sweet. Sour. Spicy."
    }
  ],
  "presets": [
    {
      "name": "Lily's graphic hero slideshow"
    }
  ]
}
{% endschema %}
