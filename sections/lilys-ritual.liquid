<section class="lc-ritual" aria-labelledby="LcRitualHeading-{{ section.id }}">
  <div class="page-width lc-ritual__layout">
    <div class="lc-ritual__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lc-eyebrow lc-eyebrow--light">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 id="LcRitualHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button lc-button lc-button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    <ol class="lc-ritual__steps">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="lc-ritual__step-number">0{{ forloop.index }}</span>
          <div>
            <h3>{{ block.settings.heading | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "The Lily's experience",
  "tag": "section",
  "class": "section section--lilys-ritual",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE LILY'S EXPERIENCE" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A three-act flavor story." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every bite is built to move—from fruit-forward sweetness to tangy chamoy to a warm chili finish.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Taste the lineup" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Flavor step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The sweet" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Big, bright fruit flavor lands first." }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Lily's experience",
      "blocks": [
        { "type": "step", "settings": { "heading": "The sweet", "text": "Big, bright fruit flavor lands first." } },
        { "type": "step", "settings": { "heading": "The tang", "text": "Chamoy brings the mouthwatering middle." } },
        { "type": "step", "settings": { "heading": "The heat", "text": "A warm chili finish keeps the bite alive." } }
      ]
    }
  ]
}
{% endschema %}
